# Copy to .env (gitignored) and fill in real values for local docker-compose runs.

SECRET_KEY=generate-with-openssl-rand-hex-32

# Google OAuth 2.0 Client ID (Web application) - Google Cloud Console >
# APIs & Services > Credentials. Its "Authorized redirect URIs" must include
# http://localhost:8080/auth/callback for local sign-in, and
# https://<your-cloud-run-url>/auth/callback once deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of bootstrap admin emails - always allowed in, and
# the only accounts that can reach Settings to approve/deny everyone else.
ALLOWED_EMAILS=
